generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  role          String         @default("VIEWER") // ADMIN, DEVELOPER, CLIENT, VIEWER
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]
  cases         Case[]         @relation("CaseAssignee")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  category    String
  message     String
  imageUrl    String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id])
}

model Case {
  id          String   @id @default(uuid())
  caseId      String   @unique // e.g., CASE-1042
  entityName  String
  riskLevel   String   // HIGH, MEDIUM, LOW
  status      String   // OPEN, UNDER_REVIEW, CLOSED
  assigneeId  String?  // Optional assignee
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee    User?    @relation("CaseAssignee", fields: [assigneeId], references: [id])
}
