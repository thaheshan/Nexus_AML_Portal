generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  role              String         @default("VIEWER") // ADMIN, DEVELOPER, CLIENT, VIEWER
  phone             String?
  avatarUrl         String?
  notificationPrefs Json?
  systemPrefs       Json?
  createdAt         DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]
  cases         Case[]         @relation("CaseAssignee")
  reports       Report[]       @relation("ReportAuthor")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  category    String
  message     String
  imageUrl    String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id])
}

model Case {
  id          String   @id @default(uuid())
  caseId      String   @unique // e.g., CASE-1042
  entityName  String
  riskLevel   String   // HIGH, MEDIUM, LOW
  status      String   // OPEN, UNDER_REVIEW, CLOSED
  assigneeId  String?  // Optional assignee
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee    User?    @relation("CaseAssignee", fields: [assigneeId], references: [id])
  alerts      Alert[]  @relation("AlertCase")
}

model Alert {
  id          String   @id @default(uuid())
  severity    String   // CRITICAL, HIGH, MEDIUM, LOW
  type        String   // TRANSACTION, SANCTIONS, THRESHOLD, PEP, DOCUMENT, VELOCITY
  description String
  relatedCaseId String? // Optional FK to Case.id
  status      String   @default("NEW") // NEW, INVESTIGATING, ACKNOWLEDGED, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  relatedCase Case?    @relation("AlertCase", fields: [relatedCaseId], references: [id])
}

model Report {
  id            String   @id @default(uuid())
  name          String
  type          String   // SUMMARY, RISK_ASSESSMENT, AUDIT_LOG
  dateRangeFrom DateTime
  dateRangeTo   DateTime
  generatedById String
  fileUrl       String?  // Optional download link
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  generatedBy   User     @relation("ReportAuthor", fields: [generatedById], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
